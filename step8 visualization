############################################################
## 11. Figure D: WDR6 vs Lipid Remodeling Module 2x2 scatter
############################################################

strict_analysis_df$condition <- factor(
  strict_analysis_df$condition,
  levels = c("Healthy", "Steatotic")
)

strict_analysis_df$StrictCentralGroup <- factor(
  strict_analysis_df$StrictCentralGroup,
  levels = c("Low central-like", "High central-like")
)

cor_group_df$condition <- factor(
  cor_group_df$condition,
  levels = c("Healthy", "Steatotic")
)

cor_group_df$StrictCentralGroup <- factor(
  cor_group_df$StrictCentralGroup,
  levels = c("Low central-like", "High central-like")
)

scatter_anno <- strict_analysis_df %>%
  group_by(condition, StrictCentralGroup) %>%
  summarise(
    x = quantile(WDR6_logNorm, probs = 0.07, na.rm = TRUE),
    y = quantile(LipidRemodelingModule_logMean, probs = 0.95, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  left_join(
    cor_group_df %>%
      select(
        condition,
        StrictCentralGroup,
        rho_WDR6_vs_LipidRemodelingModule
      ),
    by = c("condition", "StrictCentralGroup")
  ) %>%
  mutate(
    label = paste0(
      "rho = ",
      sprintf("%.3f", rho_WDR6_vs_LipidRemodelingModule)
    )
  )

write.csv(
  scatter_anno,
  file = file.path(dir_tab, "checkpoint8_scatter_annotation.csv"),
  row.names = FALSE
)

p_scatter <- ggplot(
  strict_analysis_df,
  aes(x = WDR6_logNorm, y = LipidRemodelingModule_logMean)
) +
  geom_point(alpha = 0.35, size = 0.65) +
  geom_smooth(method = "lm", se = FALSE, linewidth = 0.8) +
  facet_grid(condition ~ StrictCentralGroup, scales = "free") +
  geom_text(
    data = scatter_anno,
    aes(x = x, y = y, label = label),
    inherit.aes = FALSE,
    hjust = 0,
    vjust = 1,
    size = 4
  ) +
  theme_classic(base_size = 12) +
  labs(
    title = "WDR6 association with the Lipid Remodeling Module",
    subtitle = "Association is strongest in steatotic high central-like spots",
    x = "WDR6 expression",
    y = "Lipid Remodeling Module score"
  )

ggsave(
  filename = file.path(dir_fig, "D_WDR6_vs_LipidRemodelingModule_2x2_scatter.pdf"),
  plot = p_scatter,
  width = 9,
  height = 7
)

############################################################
## 12. Figure E: final rho dot plot with numeric labels
############################################################

p_rho_dot <- ggplot(
  cor_group_df,
  aes(
    x = condition,
    y = rho_WDR6_vs_LipidRemodelingModule,
    shape = StrictCentralGroup
  )
) +
  geom_hline(yintercept = 0, linetype = "dashed", linewidth = 0.4) +
  geom_point(
    size = 4,
    position = position_dodge(width = 0.45)
  ) +
  geom_text(
    aes(label = sprintf("%.3f", rho_WDR6_vs_LipidRemodelingModule)),
    position = position_dodge(width = 0.45),
    vjust = -0.9,
    size = 3.6
  ) +
  theme_classic(base_size = 12) +
  labs(
    title = "Disease- and region-specific WDR6-module association",
    x = NULL,
    y = "Spearman rho",
    shape = "StrictCentral group"
  )

ggsave(
  filename = file.path(dir_fig, "E_rho_dotplot_FINAL.pdf"),
  plot = p_rho_dot,
  width = 6,
  height = 4.5
)

