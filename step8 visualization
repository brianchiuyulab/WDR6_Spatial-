  group_by(condition, StrictCentralGroup) %>%
  summarise(
    n_spots = n(),
    
    mean_WDR6_logNorm = mean(
      WDR6_logNorm,
      na.rm = TRUE
    ),
    
    mean_LipidRemodelingModule_with_PLA2G4A = mean(
      LipidRemodelingModule_with_PLA2G4A,
      na.rm = TRUE
    ),
    
    rho_WDR6_vs_LipidRemodelingModule_with_PLA2G4A = suppressWarnings(
      cor(
        WDR6_logNorm,
        LipidRemodelingModule_with_PLA2G4A,
        method = "spearman",
        use = "complete.obs"
      )
    ),
    
    p_WDR6_vs_LipidRemodelingModule_with_PLA2G4A = suppressWarnings(
      cor.test(
        WDR6_logNorm,
        LipidRemodelingModule_with_PLA2G4A,
        method = "spearman",
        exact = FALSE
      )$p.value
    ),
    
    .groups = "drop"
  ) %>%
  arrange(condition, StrictCentralGroup)

