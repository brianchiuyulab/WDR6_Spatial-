############################################################
## Checkpoint 8 FINAL
## Spatial visualization summary for StrictCentral analysis
##
## Dataset:
##   GSE192742 human liver Visium
##
## Input from Step 7:
##   checkpoint7_StrictCentral_LipidRemodeling_Seurat_object_list.rds
##   checkpoint7_spot_level_StrictCentral_LipidRemodeling.csv
##   checkpoint7_StrictCentral_analysis_spots_only.csv
##   checkpoint7_WDR6_correlation_by_condition_StrictCentral_group.csv
##
## Main outputs:
##   A_all_sections_HnE_StrictCentral_groups.pdf
##   B_rep_steatotic_HnE_Central_Portal_StrictGroups.pdf
##   C_rep_healthy_HnE_Central_Portal_StrictGroups.pdf
##   D_WDR6_vs_LipidRemodelingModule_2x2_scatter.pdf
##   E_rho_dotplot_FINAL.pdf
##   checkpoint8_poster_summary_table.csv
##
## Final plotting logic:
##   High central-like = red
##   Low central-like  = blue
##   Other             = grey
##
## Lipid Remodeling Module:
##   FASN, CYP2C8, EPHX2, CYP4A11, CYP4F2
##
## WDR6 is not included in the module.
############################################################

set.seed(20260608)
options(stringsAsFactors = FALSE)

############################################################
## 1. Set directories
############################################################

project_name <- "GSE192742_WDR6_spatial"
base_dir <- file.path(getwd(), project_name)

dir_out <- file.path(base_dir, "checkpoint_outputs")
dir_step7_tab <- file.path(dir_out, "checkpoint7_StrictCentral_LipidRemodeling_tables")

dir_fig <- file.path(dir_out, "checkpoint8_FINAL_summary_figures")
dir_tab <- file.path(dir_out, "checkpoint8_FINAL_summary_tables")

if (dir.exists(dir_fig)) {
  unlink(dir_fig, recursive = TRUE, force = TRUE)
}
if (dir.exists(dir_tab)) {
  unlink(dir_tab, recursive = TRUE, force = TRUE)
}

dir.create(dir_fig, showWarnings = FALSE, recursive = TRUE)
dir.create(dir_tab, showWarnings = FALSE, recursive = TRUE)

############################################################
## 2. Load packages
############################################################

required_pkgs <- c("Seurat", "ggplot2", "dplyr", "tidyr", "patchwork")

missing_pkgs <- required_pkgs[
  !vapply(required_pkgs, requireNamespace, logical(1), quietly = TRUE)
]

if (length(missing_pkgs) > 0) {
  stop(
    "Missing packages: ",
    paste(missing_pkgs, collapse = ", "),
    "\nPlease install them first."
  )
}

library(Seurat)
library(ggplot2)
library(dplyr)
library(tidyr)
library(patchwork)

############################################################
## 3. Define representative sections
############################################################

focus_gsm_steatotic <- "GSM5764427"   # H37
focus_gsm_healthy   <- "GSM5764426"   # H36

############################################################
## 4. Load Step 7 outputs
############################################################

obj_path <- file.path(
  dir_out,
  "checkpoint7_StrictCentral_LipidRemodeling_Seurat_object_list.rds"
)

spot_path <- file.path(
  dir_step7_tab,
  "checkpoint7_spot_level_StrictCentral_LipidRemodeling.csv"
)

strict_analysis_path <- file.path(
  dir_step7_tab,
  "checkpoint7_StrictCentral_analysis_spots_only.csv"
)

cor_path <- file.path(
  dir_step7_tab,
  "checkpoint7_WDR6_correlation_by_condition_StrictCentral_group.csv"
)

required_files <- c(
  obj_path,
  spot_path,
  strict_analysis_path,
  cor_path
)

missing_files <- required_files[!file.exists(required_files)]

if (length(missing_files) > 0) {
  stop(
    "Missing required Step 7 files:\n",
    paste(missing_files, collapse = "\n"),
    "\nPlease run Step 7 first."
  )
}

obj_list <- readRDS(obj_path)
spot_df <- read.csv(spot_path, stringsAsFactors = FALSE)
strict_analysis_df <- read.csv(strict_analysis_path, stringsAsFactors = FALSE)
cor_group_df <- read.csv(cor_path, stringsAsFactors = FALSE)

cat("\nLoaded Step 7 outputs.\n")
print(names(obj_list))

############################################################
## 5. Build plot metadata
############################################################

selected_group_df <- strict_analysis_df %>%
  select(
    barcode,
    gsm,
    donor,
    condition,
    section,
    StrictCentralGroup
  ) %>%
  distinct()

plot_meta <- spot_df %>%
  select(
    barcode,
    gsm,
    donor,
    condition,
    section,
    CentralScore,
    PortalScore,
    ZonationIndex
  ) %>%
  distinct() %>%
  left_join(
    selected_group_df,
    by = c("barcode", "gsm", "donor", "condition", "section")
  ) %>%
  mutate(
    StrictCentralDisplay3 = case_when(
      StrictCentralGroup == "High central-like" ~ "High central-like",
      StrictCentralGroup == "Low central-like" ~ "Low central-like",
      TRUE ~ "Other"
    )
  )

plot_meta$StrictCentralDisplay3 <- factor(
  plot_meta$StrictCentralDisplay3,
  levels = c("High central-like", "Low central-like", "Other")
)

write.csv(
  plot_meta,
  file = file.path(dir_tab, "checkpoint8_plot_metadata.csv"),
  row.names = FALSE
)

############################################################
## 6. Add metadata back to Seurat objects by barcode matching
############################################################

obj_list_vis <- obj_list

for (gsm in names(obj_list_vis)) {
  
  obj <- obj_list_vis[[gsm]]
  
  meta_gsm <- plot_meta %>%
    filter(gsm == !!gsm) %>%
    select(
      barcode,
      CentralScore,
      PortalScore,
      ZonationIndex,
      StrictCentralDisplay3
    ) %>%
    distinct()
  
  idx <- match(colnames(obj), meta_gsm$barcode)
  
  if (all(is.na(idx))) {
    stop("No barcode match found for ", gsm)
  }
  
  obj@meta.data$CentralScore <- NA_real_
  obj@meta.data$PortalScore <- NA_real_
  obj@meta.data$ZonationIndex <- NA_real_
  obj@meta.data$StrictCentralDisplay3 <- NA_character_
  
  matched_cells <- !is.na(idx)
  
  obj@meta.data$CentralScore[matched_cells] <-
    as.numeric(meta_gsm$CentralScore[idx[matched_cells]])
  
  obj@meta.data$PortalScore[matched_cells] <-
    as.numeric(meta_gsm$PortalScore[idx[matched_cells]])
  
  obj@meta.data$ZonationIndex[matched_cells] <-
    as.numeric(meta_gsm$ZonationIndex[idx[matched_cells]])
  
  obj@meta.data$StrictCentralDisplay3[matched_cells] <-
    as.character(meta_gsm$StrictCentralDisplay3[idx[matched_cells]])
  
  obj@meta.data$StrictCentralDisplay3 <- factor(
    obj@meta.data$StrictCentralDisplay3,
    levels = levels(plot_meta$StrictCentralDisplay3)
  )
  
  cat(
    "\nMetadata added for ", gsm,
    ": matched ", sum(matched_cells), " / ", ncol(obj), " spots\n",
    sep = ""
  )
  
  obj_list_vis[[gsm]] <- obj
}

############################################################
## 7. Colors and plotting helper
############################################################

strict_cols_3 <- c(
  "High central-like" = "#D73027",
  "Low central-like" = "#4575B4",
  "Other" = "grey82"
)

make_strict_group_overlay_plot <- function(obj, title_text, pt_size = 1.6, show_legend = TRUE) {
  
  DefaultAssay(obj) <- "Spatial"
  
  p <- SpatialDimPlot(
    object = obj,
    group.by = "StrictCentralDisplay3",
    cols = strict_cols_3,
    pt.size.factor = pt_size,
    stroke = 0
  ) +
    ggtitle(title_text) +
    theme(
      plot.title = element_text(size = 11, face = "bold", hjust = 0.5),
      legend.title = element_blank()
    )
  
  if (!show_legend) {
    p <- p + theme(legend.position = "none")
  }
  
  return(p)
}

make_feature_plot <- function(obj, feature_name, title_text, pt_size = 1.6) {
  
  DefaultAssay(obj) <- "Spatial"
  
  SpatialFeaturePlot(
    object = obj,
    features = feature_name,
    pt.size.factor = pt_size
  ) +
    ggtitle(title_text) +
    theme(
      plot.title = element_text(size = 11, face = "bold", hjust = 0.5)
    )
}

############################################################
## 8. Figure A: all sections, StrictCentral groups
############################################################

section_order <- plot_meta %>%
  distinct(gsm, donor, condition, section) %>%
  arrange(condition, donor, section)

all_section_plots <- lapply(section_order$gsm, function(gsm_i) {
  
  obj_i <- obj_list_vis[[gsm_i]]
  
  title_i <- paste0(
    unique(obj_i$condition), " | ",
    unique(obj_i$donor), " | ",
    unique(obj_i$section)
  )
  
  make_strict_group_overlay_plot(
    obj = obj_i,
    title_text = title_i,
    pt_size = 1.45,
    show_legend = FALSE
  )
})

p_all_sections <- wrap_plots(all_section_plots, nrow = 1) +
  plot_annotation(
    title = "StrictCentral high and low spots across liver sections",
    subtitle = "Red: high central-like; blue: low central-like; grey: other spots",
    theme = theme(
      plot.title = element_text(size = 14, face = "bold"),
      plot.subtitle = element_text(size = 10)
    )
  )

ggsave(
  filename = file.path(dir_fig, "A_all_sections_HnE_StrictCentral_groups.pdf"),
  plot = p_all_sections,
  width = 18,
  height = 4.2
)

