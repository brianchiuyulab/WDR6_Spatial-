############################################################
## 6. Calculate PLA2G4A-included Lipid Remodeling Module score
############################################################

extract_module_score <- function(obj, gsm_name, gene_set, score_name) {
  
  DefaultAssay(obj) <- "Spatial"
  
  available_genes <- gene_set[gene_set %in% rownames(obj)]
  missing_genes <- setdiff(gene_set, available_genes)
  
  if (length(missing_genes) > 0) {
    warning(
      gsm_name,
      " missing genes: ",
      paste(missing_genes, collapse = ", ")
    )
  }
  
  if (length(available_genes) == 0) {
    stop("No module genes found in object: ", gsm_name)
  }
  
  expr_mat <- FetchData(
    object = obj,
    vars = available_genes
  )
  
  out <- data.frame(
    barcode = rownames(expr_mat),
    gsm = gsm_name,
    stringsAsFactors = FALSE
  )
  
  out[[score_name]] <- rowMeans(expr_mat, na.rm = TRUE)
  out[[paste0(score_name, "_n_genes_used")]] <- length(available_genes)
  out[[paste0(score_name, "_genes_used")]] <- paste(available_genes, collapse = ";")
  
  return(out)
}

module_score_list <- lapply(names(obj_list), function(gsm_i) {
  
  extract_module_score(
    obj = obj_list[[gsm_i]],
    gsm_name = gsm_i,
    gene_set = lipid_remodeling_genes_with_PLA2G4A,
    score_name = "LipidRemodelingModule_with_PLA2G4A"
  )
})

