make_strict_group_overlay_plot <- function(obj, title_text, pt_size = 1.6, show_legend = TRUE) {
  
  DefaultAssay(obj) <- "Spatial"
  
  p <- SpatialDimPlot(
    object = obj,
    group.by = "StrictCentralDisplay3",
    cols = strict_cols_3,
    pt.size.factor = pt_size,
    stroke = 0
  ) +
    ggtitle(title_text) +
    theme(
      plot.title = element_text(size = 11, face = "bold", hjust = 0.5),
      legend.title = element_blank()
    )
  
  if (!show_legend) {
    p <- p + theme(legend.position = "none")
  }
  
  return(p)
}

make_feature_plot <- function(obj, feature_name, title_text, pt_size = 1.6) {
  
  DefaultAssay(obj) <- "Spatial"
  
  SpatialFeaturePlot(
    object = obj,
    features = feature_name,
    pt.size.factor = pt_size
  ) +
    ggtitle(title_text) +
    theme(
      plot.title = element_text(size = 11, face = "bold", hjust = 0.5)
    )
}

