  cor_by_condition_region,
  file = file.path(dir_tab, "checkpoint7_WDR6_correlation_by_condition_StrictCentral_group.csv"),
  row.names = FALSE
)

cor_rank <- cor_by_condition_region %>%
  mutate(
    rank_WDR6_vs_LipidRemodelingModule = rank(
      -rho_WDR6_vs_LipidRemodelingModule,
      ties.method = "min",
      na.last = "keep"
    ),
    rank_WDR6_vs_FASN = rank(
      -rho_WDR6_vs_FASN,
      ties.method = "min",
      na.last = "keep"
    )
  ) %>%
