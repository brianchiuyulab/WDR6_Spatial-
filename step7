spot_df_strict <- spot_df %>%
  filter(HepatocyteEnriched) %>%
  group_by(gsm) %>%
  mutate(
    CentralScoreQuartile = ntile(CentralScore, 4),
    PortalScoreQuartile = ntile(PortalScore, 4),
    
    StrictCentralGroup = case_when(
      CentralScoreQuartile == 4 & PortalScoreQuartile == 1 ~ "High central-like",
      CentralScoreQuartile == 1 & PortalScoreQuartile == 4 ~ "Low central-like",
      TRUE ~ "Other"
    )
  ) %>%
  ungroup()

