## 15. WDR6 correlation with Lipid Remodeling Module
############################################################

cor_input <- strict_analysis_df

cor_by_condition_region <- cor_input %>%
  group_by(condition, StrictCentralGroup) %>%
  group_modify(~ {
    
    cor_module <- safe_spearman(
      x = .x$WDR6_logNorm,
      y = .x$LipidRemodelingModule_logMean
    )
    
    cor_fasn <- safe_spearman(
      x = .x$WDR6_logNorm,
      y = .x$FASN_logNorm
    )
    
    data.frame(
      n_spots_total = nrow(.x),
      n_sections = length(unique(.x$gsm)),
      n_donors = length(unique(.x$donor)),
      
      mean_WDR6_logNorm = mean(.x$WDR6_logNorm, na.rm = TRUE),
      mean_FASN_logNorm = mean(.x$FASN_logNorm, na.rm = TRUE),
      mean_LipidRemodelingModule_logMean =
        mean(.x$LipidRemodelingModule_logMean, na.rm = TRUE),
      
      WDR6_detection_rate = 100 * mean(.x$WDR6_detected, na.rm = TRUE),
      FASN_detection_rate = 100 * mean(.x$FASN_detected, na.rm = TRUE),
      LipidRemodelingModule_detected_any_rate =
        100 * mean(.x$LipidRemodelingModule_detected_any, na.rm = TRUE),
      mean_LipidRemodelingModule_n_genes_detected =
        mean(.x$LipidRemodelingModule_n_genes_detected, na.rm = TRUE),
      
      rho_WDR6_vs_LipidRemodelingModule = cor_module$spearman_rho,
      p_WDR6_vs_LipidRemodelingModule = cor_module$spearman_p,
      n_used_WDR6_vs_LipidRemodelingModule = cor_module$n_used,
      
      rho_WDR6_vs_FASN = cor_fasn$spearman_rho,
      p_WDR6_vs_FASN = cor_fasn$spearman_p,
      n_used_WDR6_vs_FASN = cor_fasn$n_used
    )
  }) %>%
  ungroup()

cat("\nWDR6 correlation by condition and StrictCentral group:\n")
