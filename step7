############################################################
## 5. Helper functions
############################################################

get_data_matrix <- function(obj) {
  mat <- tryCatch(
    GetAssayData(object = obj, assay = "Spatial", layer = "data"),
    error = function(e) {
      GetAssayData(object = obj, assay = "Spatial", slot = "data")
    }
  )
  return(mat)
}

get_counts_matrix <- function(obj) {
  mat <- tryCatch(
    GetAssayData(object = obj, assay = "Spatial", layer = "counts"),
    error = function(e) {
      GetAssayData(object = obj, assay = "Spatial", slot = "counts")
    }
  )
  return(mat)
}

mean_log_score <- function(data_mat, genes) {
  genes_present <- genes[genes %in% rownames(data_mat)]
  
  if (length(genes_present) == 0) {
    return(rep(NA_real_, ncol(data_mat)))
  }
  
  Matrix::colMeans(data_mat[genes_present, , drop = FALSE])
}

count_detected_genes <- function(counts_mat, genes) {
  genes_present <- genes[genes %in% rownames(counts_mat)]
  
  if (length(genes_present) == 0) {
    return(rep(NA_integer_, ncol(counts_mat)))
  }
  
  Matrix::colSums(counts_mat[genes_present, , drop = FALSE] > 0)
}

get_gene_expr <- function(data_mat, gene) {
  if (gene %in% rownames(data_mat)) {
    return(as.numeric(data_mat[gene, ]))
  } else {
    return(rep(NA_real_, ncol(data_mat)))
  }
}

get_gene_detected <- function(counts_mat, gene) {
  if (gene %in% rownames(counts_mat)) {
    return(as.numeric(counts_mat[gene, ]) > 0)
  } else {
    return(rep(NA, ncol(counts_mat)))
  }
}

safe_spearman <- function(x, y) {
  
  keep <- is.finite(x) & is.finite(y)
  
  if (sum(keep) < 5) {
    return(data.frame(
      spearman_rho = NA_real_,
      spearman_p = NA_real_,
      n_used = sum(keep)
    ))
  }
  
  if (length(unique(x[keep])) < 2 || length(unique(y[keep])) < 2) {
    return(data.frame(
      spearman_rho = NA_real_,
      spearman_p = NA_real_,
      n_used = sum(keep)
    ))
  }
  
  ct <- suppressWarnings(
    cor.test(
      x = x[keep],
      y = y[keep],
      method = "spearman",
      exact = FALSE
    )
  )
  
  data.frame(
    spearman_rho = unname(ct$estimate),
    spearman_p = ct$p.value,
    n_used = sum(keep)
  )
}

############################################################
## 6. Add hepatocyte score, WDR6, and Lipid Remodeling Module
############################################################

obj_list_step7 <- lapply(names(obj_list), function(gsm) {
  
  obj <- obj_list[[gsm]]
  DefaultAssay(obj) <- "Spatial"
  
  cat("\nProcessing:", gsm, "\n")
  
  data_mat <- get_data_matrix(obj)
  counts_mat <- get_counts_matrix(obj)
  
  hepatocyte_genes_present <- hepatocyte_markers[
    hepatocyte_markers %in% rownames(data_mat)
  ]
  
  module_genes_present <- lipid_remodeling_module[
    lipid_remodeling_module %in% rownames(data_mat)
  ]
  
  tracking_genes_present <- tracking_genes[
    tracking_genes %in% rownames(data_mat)
  ]
  
  if (length(hepatocyte_genes_present) == 0) {
    stop("No hepatocyte markers detected in ", gsm)
  }
  
  if (length(module_genes_present) == 0) {
    stop("No Lipid Remodeling Module genes detected in ", gsm)
  }
  
  cat("Detected hepatocyte markers:", paste(hepatocyte_genes_present, collapse = ", "), "\n")
  cat("Detected module genes:", paste(module_genes_present, collapse = ", "), "\n")
  
  ## Hepatocyte score
  obj$HepatocyteScore <- mean_log_score(data_mat, hepatocyte_markers)
  hepatocyte_cutoff <- median(obj$HepatocyteScore, na.rm = TRUE)
  obj$HepatocyteEnriched <- obj$HepatocyteScore >= hepatocyte_cutoff
  
  ## WDR6 single gene, analyzed separately
  obj$WDR6_logNorm <- get_gene_expr(data_mat, "WDR6")
  obj$WDR6_detected <- get_gene_detected(counts_mat, "WDR6")
  
  ## Lipid Remodeling Module, excluding WDR6
  obj$LipidRemodelingModule_logMean <- mean_log_score(
    data_mat,
    lipid_remodeling_module
  )
  
  obj$LipidRemodelingModule_n_genes_detected <- count_detected_genes(
    counts_mat,
    lipid_remodeling_module
  )
  
  obj$LipidRemodelingModule_detected_any <-
    obj$LipidRemodelingModule_n_genes_detected >= 1
  
  obj$LipidRemodelingModule_detected_strict <-
    obj$LipidRemodelingModule_n_genes_detected >= 3
  
  ## Individual tracking genes
  for (gene in unique(c(lipid_remodeling_module, "WDR6", "GLUL", "CYP2E1", "HAL", "SDS"))) {
    obj[[paste0(gene, "_logNorm")]] <- get_gene_expr(data_mat, gene)
    obj[[paste0(gene, "_detected")]] <- get_gene_detected(counts_mat, gene)
  }
  
  obj$HepatocyteScore_cutoff_used <- hepatocyte_cutoff
  obj$HepatocyteGenes_used <- paste(hepatocyte_genes_present, collapse = ";")
  obj$LipidRemodelingModule_genes_used <- paste(module_genes_present, collapse = ";")
  obj$LipidRemodelingModule_n_genes_used <- length(module_genes_present)
  obj$TrackingGenes_present <- paste(tracking_genes_present, collapse = ";")
  
  return(obj)
})

